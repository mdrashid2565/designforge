# Environment Configuration for DesignForge
PORT=3000
MCP_PORT=4000
NODE_ENV=development

# Database & Cache (Optional / Production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/designforge
REDIS_URL=redis://localhost:6379

# Storage (S3 / MinIO)
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=designforge-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI Model Providers (Optional: Users can also input keys via UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# MCP Server Security & Auth
MCP_AUTH_SECRET=designforge-mcp-secret-key-2026
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MCP_SSE_URL=http://localhost:4000/sse
